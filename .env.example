# Telegram bot: replace the placeholder with a BotFather token.
BOT_TOKEN=replace_with_your_bot_token
PARSE_MODE=HTML
DROP_PENDING_UPDATES=False
RATE_LIMIT=0.5
ADMINS=[]
DEBUG_MODE=False
# LOG_CHAT=your_optional_log_chat_id

# PostgreSQL (required)
DB_USED=PostgreSQL
DB_IP=127.0.0.1:5432
DB_USER=stars_quest
DB_PASSWORD=replace_with_a_database_password
DB_NAME=stars_quest

# Redis (optional)
REDIS_USE=False
REDIS_IP=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Crypto Pay API
CRYPTOPAY_TOKEN=

# Fragment: authenticated cookies; hash can refresh automatically.
FRAGMENT_COOKIES=
FRAGMENT_HASH_VALUE=

# TON wallet for Fragment delivery. Store real values only in .env.
TONAPI_MNEMONIC=
TONAPI_API_KEY=
TONAPI_RECEIVE_ADDRESS=

# FreeKassa (optional)
FREKASSA_SHOP_ID=0
FREKASSA_API_KEY=
FREKASSA_SECRET_WORD_2=
NOTIFICATIONS_HOST=127.0.0.1
NOTIFICATIONS_PORT=8789
NOTIFICATIONS_RETURN_URL=https://t.me/syndicatestars_bot
